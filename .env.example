# ============================================================================
# .env.example — copy thành .env rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env (chứa secret thật) — chỉ commit file này.
# ============================================================================

# ---------- MySQL / TiDB (backend) ----------
MYSQL_DATABASE=history_rag
MYSQL_USER=history
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root
MYSQL_URL=jdbc:mysql://mysql:3306/history_rag

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
UPLOAD_BASE_PATH=/app/uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=change-me
RAG_SERVICE_URL=http://rag-service:8001
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080

# ---------- Qdrant (vector store) ----------
# Local docker: http://qdrant:6333, không cần API key.
# Qdrant Cloud: dùng URL https://xxx.cloud.qdrant.io + API key riêng.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=history_chunks

# ---------- Neo4j (Graph RAG) ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-neo4j
NEO4J_DATABASE=neo4j
# Chỉ cần nếu dùng Neo4j Aura (cloud) thay vì Neo4j local:
AURA_INSTANCEID=
AURA_INSTANCENAME=

# ---------- MongoDB Atlas — log lượt hỏi-đáp RAG (rag_query_logs), evaluation/debug (docs/18) ----------
# Để trống = tắt log, không ảnh hưởng chat (query_log_service tự no-op).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ---------- LLM — Google GenAI (Gemini/Gemma) ----------
LLM_PROVIDER=mock
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=change-me
LLM_MODEL=mock-llm
LLM_FALLBACK_MODEL=mock-llm
# Pool thêm key (mỗi biến có thể chứa nhiều key ngăn cách dấu phẩy) — dùng
# khi key chính dính rate-limit/hết quota ngày. Để trống nếu chỉ có 1 key.
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# ---------- LLM — Groq (OpenAI-compatible, multi-provider routing) ----------
GROQ_API_KEY=

# ---------- LLM — OpenAI (dự phòng, hiện chưa dùng chính) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Embedding ----------
EMBEDDING_MODEL=mock-embedding
# LƯU Ý: phải khớp đúng dim của collection Qdrant đã tạo (thường 768 cho
# gemini-embedding-001) — đổi giá trị này KHÔNG đổi thực tế embedding_dim
# trong code (hiện hard-code 768), chỉ để tham khảo/tài liệu.
EMBEDDING_DIMENSION=768

# ---------- Tham số pipeline RAG ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SCORE=0.55
MAX_CONTEXT_CHUNKS=3

# Nhánh wiki-local RRF: dùng collection wiki_chunks_local + model fastembed
# e5-large (~2.2GB). Cần ≥6GB RAM cho rag-service, nếu không sẽ OOM. Để false
# nếu máy ít RAM hoặc chưa import wiki. Docker cache model qua volume
# rag-model-cache (FASTEMBED_CACHE_DIR trong docker-compose).
WIKI_LOCAL_ENABLED=false

# ---------- JWT (rag-service dùng riêng nếu có, khác JWT_SECRET_KEY backend) ----------
JWT_SECRET=change-me
JWT_EXPIRES_IN=86400000

# ---------- Upload / storage ----------
STORAGE_PATH=./storage/uploads
DEBUG_REPORT_PATH=./storage/debug
MAX_FILE_SIZE_MB=150

# ---------- Ports (đổi nếu bị trùng cổng máy local) ----------
RAG_PORT=8001
RAG_API_URL=http://127.0.0.1:8001