# Template cho GROQ_API_KEY dùng riêng cho benchmark SSE vs WS (stream_source=groq).
#
# Copy file này thành `.env.groq.local` (đã có trong .gitignore, KHÔNG commit),
# điền key thật vào. File này KHÔNG liên quan gì tới `.env` gốc của repo (cái
# Docker Compose / production dùng) — hoàn toàn tách biệt, chỉ được đọc bởi
# benchmark khi STREAM_SOURCE=groq.
#
# Lấy key free tại: https://console.groq.com (không cần thẻ tín dụng)

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
